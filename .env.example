# --- Local OpenAI-compatible VLM endpoint (Stage 1 + Stage 2) ---
# Base URL must include the OpenAI-compatible path (usually /v1).
LLM_BASE_URL=http://192.168.100.1:5000/v1
# Any non-empty string; local servers (vLLM) ignore the value but the client requires it.
LLM_API_KEY=not-needed
# Must match exactly what the server advertises at GET /v1/models.
# The running server currently serves "gemma-4-31B-it"; change to "Qwen3.8-27B" when loaded.
LLM_MODEL=gemma-4-31B-it

# --- PostgreSQL + pgvector (Stage 2 document store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assets
POSTGRES_USER=assets
POSTGRES_PASSWORD=assets

# --- Embeddings (only used by the optional pgvector shortlist path) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
